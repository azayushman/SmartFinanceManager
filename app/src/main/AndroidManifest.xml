<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".SmartFinanceApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartFinanceManager"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.loans.AddLoanActivity"
            android:exported="false" />
        <activity
            android:name=".ui.loans.LoanDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.transactions.AddTransactionActivity"
            android:exported="false" />
        <activity
            android:name=".ui.loans.AddCardActivity"
            android:exported="false" />
        <activity
            android:name=".ui.loans.CardDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.loans.AddStatementActivity"
            android:exported="false" />
        <activity
            android:name=".ui.budgets.SetBudgetActivity"
            android:exported="false" />
    </application>

</manifest>